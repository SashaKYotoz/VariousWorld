  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://sashakyotoz.github.io/sashakyotoz_dev/",
    "sources": "https://github.com/SashaKYotoz/VariousWorld"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
